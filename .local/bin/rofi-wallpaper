#!/usr/bin/env zsh

WALL_DIR="$HOME/HDD/Pictures/wallpaper"
ROFI_THEME="$HOME/.config/rofi/launchers/type-6/style-6.rasi"

# Category selection ---
CATEGORY=$(find "$WALL_DIR" -mindepth 1 -maxdepth 1 -type d -printf "%f\n" | rofi -dmenu -p "Category" -theme "$ROFI_THEME")
[ -z "$CATEGORY" ] && exit

# Pick wallpaper ---
WALL_NAME=$(find "$WALL_DIR/$CATEGORY" -type f -printf "%f\n" | rofi -dmenu -p "Wallpaper" -theme "$ROFI_THEME")
[ -z "$WALL_NAME" ] && exit
WALL="$WALL_DIR/$CATEGORY/$WALL_NAME"

# Execute setwal ---
"$HOME/dotfiles/.local/bin/setwal" "$WALL"

# Link Pywal's generated theme into Yazi ---
mkdir -p "$HOME/.config/yazi/flavors/pywal.yazi"
cp "$HOME/.cache/wal/theme.toml" "$HOME/.config/yazi/flavors/pywal.yazi/flavor.toml" 2>/dev/null

# Notify (delayed so it fires after setwal/theme reload settle) ---
( sleep 1 && notify-send -t 5000 "Wallpaper changed" "$CATEGORY / $WALL_NAME" ) &
disown
