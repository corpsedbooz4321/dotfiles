# Navigation
alias ..="cd .."
alias ...="cd ../.."

# Listing
alias ls="ls --color=auto"
alias ll="exa -l"
alias la="ls -A"

#system
alias updateall="sudo pacman -Syu"
alias ins="sudo pacman -S"

# Git
alias g="git"
alias gs="git status"
alias gc="git commit -m"
alias gp="git push"
alias gl="git pull"

# Misc
alias cls="clear"
alias reload="source ~/.zshrc"


#apps
alias fs="fastfetch"
