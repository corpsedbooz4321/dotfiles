#!/usr/bin/env zsh

WALL_DIR="$HOME/HDD/Pictures/wallpaper"
ROFI_THEME="$HOME/.config/rofi/launchers/type-6/style-6.rasi"

# Category selection ---
CATEGORY=$(find "$WALL_DIR" -mindepth 1 -maxdepth 1 -type d -printf "%f\n" | rofi -dmenu -p "Category" -theme "$ROFI_THEME")
[ -z "$CATEGORY" ] && exit

# Pick wallpaper ---
WALL=$(find "$WALL_DIR/$CATEGORY" -type f | rofi -dmenu -p "Wallpaper" -theme "$ROFI_THEME")
[ -z "$WALL" ] && exit

# Execute setwal ---
"$HOME/dotfiles/scripts/.local/bin/setwal" "$WALL"

# Link Pywal's generated theme into Yazi ---
mkdir -p "$HOME/.config/yazi/flavors/pywal.yazi"
cp "$HOME/.cache/wal/theme.toml" "$HOME/.config/yazi/flavors/pywal.yazi/flavor.toml" 2>/dev/null

# Notify ---
notify-send "Wallpaper changed" "$CATEGORY"
