{
  "Main Function": {
    "prefix": "main",
    "body": [
      "#include <stdio.h>",
      "",
      "int main(void) {",
      "    $0",
      "    return 0;",
      "}"
    ],
    "description": "Basic main function boilerplate"
  },
  "Printf Print": {
    "prefix": "pf",
    "body": ["printf(\"${1:%d\\n}\", $2);"],
    "description": "Simple formatted print"
  },
  "Scanf Input": {
    "prefix": "sc",
    "body": ["scanf(\"${1:%d}\", &${2:var});"],
    "description": "Read standard input"
  },
  "For Loop": {
    "prefix": "fori",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {",
      "    $0",
      "}"
    ],
    "description": "Standard 0 to n counting loop"
  },
  "While Loop": {
    "prefix": "wh",
    "body": ["while (${1:condition}) {", "    $0", "}"],
    "description": "Basic while loop"
  },
  "If Statement": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "    $0", "}"],
    "description": "Simple if check"
  },
  "If Else": {
    "prefix": "ife",
    "body": ["if (${1:condition}) {", "    $2", "} else {", "    $0", "}"],
    "description": "If-else branch"
  },
  "1D Array Declaration": {
    "prefix": "arr",
    "body": ["int ${1:arr}[${2:size}];"],
    "description": "Declare an integer array"
  },
  "Loop Over Array": {
    "prefix": "forarr",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:size}; ${1:i}++) {",
      "    printf(\"%d \", ${3:arr}[${1:i}]);",
      "}",
      "printf(\"\\n\");"
    ],
    "description": "Print array elements"
  },
  "Void Function": {
    "prefix": "func",
    "body": ["void ${1:function_name}(${2:void}) {", "    $0", "}"],
    "description": "Custom helper function"
  }
}
